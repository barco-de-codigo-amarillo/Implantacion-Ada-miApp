DELIMITER //

CREATE TRIGGER trg_catedratico_telefono
AFTER INSERT ON profesor
FOR EACH ROW
BEGIN
    IF NEW.categoria = 'Catedráticos de Universidad' THEN
        INSERT INTO tlfContactoProf (idProfesor, telefono)
        VALUES (NEW.idProfesor, 999999999);
    END IF;
END//

